# Server-side vision analysis
ANTHROPIC_API_KEY=
VISION_ANALYSIS_MODEL=claude-opus-4-1-20250805
VISION_FALLBACK_MODEL=

# Generic image rendering backend
# Map your image-render provider key here. Do not use public/browser-exposed keys.
RENDER_KEY_PRIMARY=
RENDER_MODEL_PRIMARY=gemini-3-pro-image-preview

# Optional Gemini fallback image rendering backend. Defaults to RENDER_KEY_PRIMARY
# when RENDER_KEY_FALLBACK is empty.
RENDER_KEY_FALLBACK=
RENDER_MODEL_FALLBACK=gemini-2.5-flash-image

# Optional third-party HTTP render fallback backend
RENDER_HTTP_FALLBACK_KEY=
RENDER_HTTP_FALLBACK_ENDPOINT=

# Supabase server-side upload support
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=uploads

# Future browser-safe Supabase Auth client settings.
# Never put SUPABASE_KEY in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local API/runtime
NEXT_PUBLIC_SITE_URL=https://windofy.nl
AI_SERVICE_URL=http://127.0.0.1:5000
AI_HOST=127.0.0.1
AI_PORT=5000
PORT=5000
